# ==========================================
# Configuración de Bot-EVV
# ==========================================

# JID del grupo objetivo donde responderá el bot (ej: 120363041234567890@g.us)
TARGET_GROUP_JID=""

# JID de Meta AI en WhatsApp (se obtiene y confirma en la Fase 1 / PoC)
# Ejemplos comunes: 13135550002@s.whatsapp.net o el que registre la consola al enviarle un mensaje directo
META_AI_JID=""

# Modo pruebas sin envío real al grupo (true / false)
DRY_RUN=false

# Nivel de log (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# ==========================================
# Proveedor de IA de Respaldo y Resúmenes
# ==========================================
# Opciones: groq, openrouter, together
AI_PROVIDER=groq
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"

# ==========================================
# Base de Datos y Programación
# ==========================================
DB_PATH="data/bot.sqlite"
TIMEZONE="America/Argentina/Cordoba"
INACTIVITY_THRESHOLD_HOURS=6
INACTIVITY_COOLDOWN_HOURS=12
NEWS_COUNT=3
