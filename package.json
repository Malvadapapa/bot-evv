{
  "name": "bot-evv",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para grupos con integración a Meta AI y proveedores de LLM",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "poc": "tsx src/poc/poc-meta-ai.ts",
    "test-bot": "tsx src/poc/test-meta-bot.ts",
    "bridge": "cd meta-ai-bridge && wametaai.exe",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "start": "node dist/index.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "meta-ai",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.19",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
